{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "moduleResolution": "node",

    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],

    // ⭐️ CRÍTICO para o erro que você recebeu
    "types": ["node"]
  },

  // ❗️ Remova o prisma do include (não precisa compilar seed.ts)
  "include": ["src/**/*"],

  // ❗️ Opcional: excluir seed explicitamente
  "exclude": ["node_modules", "dist", "prisma/seed.ts"]
}
