{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./", 
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    

    "lib": ["ES2020"] 
  },
  "include": ["src/**/*", "prisma/**/*"], 
  "exclude": ["node_modules", "dist"]
}