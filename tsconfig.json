{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./", 
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
    // Mantenha strict como false para evitar o TS7006 (any implícito)
    "strict": false, 
    
    "skipLibCheck": true,
    
    // ✅ CRÍTICO: Usa esta linha para corrigir 'console' e 'finally'
    "lib": ["ES2020", "DOM"] 
    
    // 🛑 REMOVIDO: A linha "types": ["node"] DEVE ESTAR AUSENTE
  },
  "include": ["src/**/*", "prisma/**/*"], 
  "exclude": ["node_modules", "dist"]
}