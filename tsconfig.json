{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./", 
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
    "strict": false, // Mantém o deploy funcionando (TS7006 desativado)
    
    "skipLibCheck": true,
    
    "lib": ["ES2020", "DOM"] // ✅ A maneira correta de incluir APIs globais
    
    // 🛑 REMOVER: Não deve haver uma linha 'types: [...]' aqui.
  },
  "include": ["src/**/*", "prisma/**/*"], 
  "exclude": ["node_modules", "dist"]
}